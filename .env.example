# Server-only. Do not prefix with VITE_ or put credentials in this URL.
POCKETBASE_URL=http://127.0.0.1:8090

# Google Calendar: server-only Web application OAuth credentials.
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, encoded as 64 hexadecimal characters. Keep stable and private.
GOOGLE_CALENDAR_TOKEN_KEY=

# Optional, server-only: Open-Meteo commercial API key. Empty uses the free
# non-commercial endpoints for city search and header weather.
OPEN_METEO_API_KEY=
